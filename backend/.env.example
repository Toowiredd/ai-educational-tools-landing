# Server Configuration
NODE_ENV=development
PORT=8080
HOST=0.0.0.0

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Database (PostgreSQL)
# Use Neon, Supabase, or any PostgreSQL provider
# Example: postgresql://user:password@host:5432/database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_edu_tools

# Redis (for caching and sessions)
# Use Upstash Redis (Cloudflare-compatible) or local Redis
REDIS_URL=redis://localhost:6379

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this
JWT_REFRESH_EXPIRES_IN=30d

# AI Provider (choose one)
# Anthropic Claude
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# OpenAI GPT
OPENAI_API_KEY=your-openai-api-key-here

# AI Provider to use (anthropic or openai)
AI_PROVIDER=anthropic

# Email Configuration (optional for now)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Cloudflare Configuration (for file uploads)
CLOUDFLARE_ACCOUNT_ID=your-account-id
CLOUDFLARE_R2_ACCESS_KEY_ID=your-r2-access-key
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your-r2-secret-key
CLOUDFLARE_R2_BUCKET_NAME=ai-edu-tools-uploads

# WebRTC/Video Provider (100ms or Daily.co)
HMS_APP_ACCESS_KEY=your-100ms-access-key
HMS_APP_SECRET=your-100ms-secret
# OR
DAILY_API_KEY=your-daily-api-key

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
